# Photon — https://app.photon.codes → project Settings
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Anthropic — powlo's reasoning
ANTHROPIC_API_KEY=

# "imessage" for the real thing, "terminal" for local dry runs
POWLO_CHANNEL=terminal

# Public HTTPS base for the live mini-app card (cloudflared/ngrok tunnel)
POWLO_PUBLIC_URL=http://localhost:8787
POWLO_PORT=8787
