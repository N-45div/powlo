# Photon — https://app.photon.codes → project Settings
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# OpenAI — powlo's reasoning
OPENAI_API_KEY=

# Optional. Conversational turns run on luna; the floor decision gets terra.
# Set POWLO_MODEL_NEGOTIATE=gpt-5.6-luna to run everything on one model.
# POWLO_MODEL=gpt-5.6-luna
# POWLO_MODEL_NEGOTIATE=gpt-5.6-terra

# "imessage" for the real thing, "terminal" for local dry runs
POWLO_CHANNEL=terminal

# Public HTTPS base for the live mini-app card (cloudflared/ngrok tunnel)
POWLO_PUBLIC_URL=http://localhost:8787
POWLO_PORT=8787
